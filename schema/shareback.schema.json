{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_name",
    "style_code",
    "test_type",
    "test_date",
    "participants",
    "average_rating",
    "rating_scale",
    "recommendation",
    "reviewer_names",
    "key_findings",
    "notes"
  ],
  "properties": {
    "product_name": { "type": "string", "minLength": 1 },
    "style_code": { "type": "string", "pattern": "^[A-Z]{2,4}[0-9]{1,2}-[0-9]{2}$" },
    "test_type": { "type": "string", "enum": ["wear", "lab"] },
    "test_date": { "type": "string", "format": "date" },
    "participants": { "type": "integer", "minimum": 1, "nullable": true },
    "average_rating": { "type": "number", "minimum": 1, "maximum": 5 },
    "rating_scale": { "type": "integer", "enum": [5] },
    "recommendation": { "type": "string", "enum": ["ship", "revise", "drop"] },
    "reviewer_names": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "key_findings": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "string", "nullable": true }
  }
}
